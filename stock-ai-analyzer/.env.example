# Stock AI Analyzer Configuration
# Copy this file to .env and fill in your values

# Database (SQLite default, or use PostgreSQL URL)
DATABASE_URL=sqlite:///./stock_analyzer.db
# DATABASE_URL=postgresql://user:password@localhost:5432/stock_analyzer

# Data APIs
NEWS_API_KEY=your_newsapi_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Scheduler
DATA_REFRESH_HOUR=18
DATA_REFRESH_MINUTE=0

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
